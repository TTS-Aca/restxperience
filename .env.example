# Dentro de Docker Compose esta URL la pisa el servicio `app` (host `db`).
# En el host (Prisma Studio) usa localhost. En Render la inyecta Postgres.
DATABASE_URL="postgresql://restx:restx@localhost:5432/restxperience?schema=public"

ADMIN_PASSWORD="restx-admin"
ADMIN_SESSION_SECRET="rx-session-secret-change-me"

KITCHEN_PASSWORD="restx-kitchen"
KITCHEN_SESSION_SECRET="rx-kitchen-session-secret"

# Stripe TEST (modo demo visual). Sin secret key el checkout es local.
# 1) Dashboard → Developers → API keys
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# 2) Después de desplegar: Developers → Webhooks → Add endpoint
#    URL: https://<tu-servicio>.onrender.com/api/webhooks/stripe
#    Eventos: checkout.session.completed, checkout.session.async_payment_succeeded,
#             checkout.session.expired, checkout.session.async_payment_failed
STRIPE_WEBHOOK_SECRET="whsec_..."

# Cloudflare R2 — fotos/videos (sin esto, local usa public/uploads)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="restxperience-media"
R2_PUBLIC_BASE_URL="https://pub-xxxx.r2.dev"
